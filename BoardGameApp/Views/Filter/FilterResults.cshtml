@model List<BoardGameApp.Models.ViewModels.FilterDetailsViewModel>

@{
    ViewData["Title"] = "Filtered Results";
}

@foreach (var game in Model)
{
    <div class="card-container">
        <div class="bg-card">
            <div class="bg-card__header">
                <p class="title">@game.Game.Name</p>
            </div>
            <div class="bg-card__body">
                <div class="center-txt">
                    <p>Počet her</p><p>@game.Count</p>
                </div>
                <div class="center-txt">
                    <p>Rekord</p>
                    <p>
                    @if (game.Records != null && game.Records.Count > 0)
                    {
                        @game.Records[0].Item2

                        <span>(</span>

                        @for(int i = 0; i < game.Records.Count; i++)
                        {
                            @game.Records[i].Item1.Name
                            @if (@game.Records[i].Item3 != null)
                            {
                                <span> - </span> @game.Records[i].Item3.Name
                            }
                            @if (i < game.Records.Count - 1)
                            {
                                <span>, </span>
                            }
                        }
                        <span>)</span>
                    }
                    </p>
                </div>
            </div>
        </div>
        <div class="bg-card">
            <div class="bg-card__header">
                <p class="title">Výherci</p>
            </div>
            <div class="bg-card__body">
                @foreach (var best in game.Winners)
                {
                    <div class="center-txt">
                        <p>@best.Item1.Name</p><p>@best.Item2</p>
                    </div>
                }
            </div>
        </div>
        @if (game.TopRoles != null && game.TopRoles.Count > 0)
        {
            @foreach (var top in game.TopRoles)
            {
                <div class="bg-card">
                    <div class="bg-card__header">
                        <p class="title">Role - @top.Key.Name</p>
                    </div>
                    <div class="bg-card__body">
                        @if (top.Value != null && top.Value.Count > 0)
                        {
                            <table class="bg-table">
                                @foreach (var i in top.Value)
                                {
                                    <tr>
                                        <td>@(@i.Item1 != null ? $"{i.Item1.Name}" : "-- unknown --")</td>
                                        <td>@i.Item2</td>
                                        <td>@i.Item3</td>
                                    </tr>
                                }
                            </table>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <hr />
}